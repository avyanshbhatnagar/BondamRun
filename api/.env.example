# Copy to .env and fill in. Never commit .env.

# Create at dash.cloudflare.com -> My Profile -> API Tokens (permissions are listed in README.md)
CLOUDFLARE_API_TOKEN=

# dash.cloudflare.com -> Workers & Pages -> right-hand sidebar "Account ID"
CLOUDFLARE_ACCOUNT_ID=

# Where the game is served from: the ORIGIN only (no path, no trailing slash).
# GitHub Pages: https://<your-github-username>.github.io   (comma-separate several)
ALLOWED_ORIGINS=https://avyanshbhatnagar.github.io

# Only needed the very first time, if your account has no workers.dev subdomain yet.
# Must be globally unique; the API will live at https://<WORKER_NAME>.<this>.workers.dev
WORKERS_SUBDOMAIN=

# Optional
# WORKER_NAME=bondam-run-api
# D1_NAME=bondam-run-db
